# Copy to .env and fill in. All PRINT_BUDDY__SECTION__KEY values override config/docker.yaml.
# Lists (orca.command, printer.bed_mm) cannot come from the environment; mount a full YAML or TOML config.
# The one exception is PRINT_BUDDY__DELIVERY__METHODS, a comma- or space-separated list (see below).
# A mounted file replaces /app/config/docker.yaml rather than layering on it: copy docker.yaml and edit the copy.
# Optional: PRINT_BUDDY_CONFIG=/app/config/docker.toml selects a legacy TOML mount instead of the YAML default.
# See README "All settings" and config/home.yaml for defaults.
# Docker defaults are in config/docker.yaml; config/docker.toml remains supported when explicitly selected.

# --- Services (required for a working install) ---
PRINT_BUDDY__SERVICES__MOONRAKER_URL=http://printer.example:7125
# PRINT_BUDDY__SERVICES__MOONRAKER_WS_URL=
# PRINT_BUDDY__SERVICES__CAMERA_SNAPSHOT_URL=
PRINT_BUDDY__SERVICES__SPOOLMAN_URL=
# Leave empty: the container uses its bundled Spoolman API at http://127.0.0.1:8000.
# For an existing external instance, set http://spoolman.example:8000 here and
# PRINT_BUDDY_BUNDLED_SPOOLMAN=false below. Nothing is migrated either way.
# PRINT_BUDDY__SERVICES__OPENVIKING_URL=
# PRINT_BUDDY__SERVICES__VISION_CHAT_URL=
# PRINT_BUDDY__SERVICES__STOCK_API_PORT=8898

# --- Printer ---
# PRINT_BUDDY__PRINTER__MODEL=flashforge.ad5x
# PRINT_BUDDY__PRINTER__NAME=
# PRINT_BUDDY__PRINTER__NOZZLE_DIAMETER_MM=0.4
# PRINT_BUDDY__PRINTER__MAX_PRINT_HEIGHT_MM=220
# PRINT_BUDDY__PRINTER__IFS_SLOTS=4
# PRINT_BUDDY__PRINTER__START_MACRO=PRINT_START
# PRINT_BUDDY__PRINTER__END_MACRO=PRINT_END

# --- Discord ---
# PRINT_BUDDY__DISCORD__CHAT_ID=
# PRINT_BUDDY__DISCORD__APPROVAL_USER_ID=
# PRINT_BUDDY__DISCORD__UPLOAD_MAX_BYTES=9500000
# PRINT_BUDDY__DISCORD__POST_PRINT_QUIET_S=7200
# PRINT_BUDDY__DISCORD__DAILY_RESET_HOUR=4
# PRINT_BUDDY__DISCORD__TIMEZONE=America/New_York
# PRINT_BUDDY__DISCORD__BOT_NAME=Print Buddy

# --- Telegram (standalone bot when PRINT_BUDDY__BOT__PLATFORM=telegram, #164) ---
# The token itself goes in the TELEGRAM_BOT_TOKEN secret below, never here.
# PRINT_BUDDY__TELEGRAM__TOKEN_ENV=TELEGRAM_BOT_TOKEN
# PRINT_BUDDY__TELEGRAM__CHAT_ID=
# PRINT_BUDDY__TELEGRAM__ALLOWED_USER_IDS=
# PRINT_BUDDY__TELEGRAM__APPROVAL_USER_ID=
# PRINT_BUDDY__TELEGRAM__UPLOAD_MAX_BYTES=50000000

# --- Matrix (standalone bot when PRINT_BUDDY__BOT__PLATFORM=matrix, #164) ---
# The token itself goes in the MATRIX_ACCESS_TOKEN secret below, never here.
# PRINT_BUDDY__MATRIX__HOMESERVER_URL=
# PRINT_BUDDY__MATRIX__ACCESS_TOKEN_ENV=MATRIX_ACCESS_TOKEN
# PRINT_BUDDY__MATRIX__ROOM_ID=
# PRINT_BUDDY__MATRIX__ALLOWED_USER_IDS=
# PRINT_BUDDY__MATRIX__APPROVAL_USER_ID=
# PRINT_BUDDY__MATRIX__BOT_USER_ID=
# PRINT_BUDDY__MATRIX__UPLOAD_MAX_BYTES=50000000

# --- Paths (container paths; volumes map host dirs) ---
# PRINT_BUDDY__PATHS__HERMES_HOME=/data/hermes
# PRINT_BUDDY__PATHS__ARCHIVE=/data/archive
# PRINT_BUDDY__PATHS__RECORDS_VAULT=/data/records
# PRINT_BUDDY__PATHS__CACHE=/data/cache
# PRINT_BUDDY__PATHS__FFMPEG=ffmpeg

# --- Visual watch / listener / vision / timelapse / maintenance ---
# PRINT_BUDDY__VISUAL_WATCH__SENSITIVITY=3
# PRINT_BUDDY__LISTENER__TICK_S=600
# PRINT_BUDDY__VISION__MODEL=gemini-latest
# PRINT_BUDDY__VISION__ROAST_MODEL=luna-latest
# PRINT_BUDDY__TIMELAPSE__ARCHIVE_HOST=
# PRINT_BUDDY__MAINTENANCE__QUICK_HOURS=25

# Legacy names still accepted (MOONRAKER_URL, SPOOLMAN_URL, ...). See settings.py LEGACY_ENV.

# --- Combined Docker container (required values must be filled before startup) ---
# An empty DISCORD_BOT_TOKEN keeps the bot idle while the listener and Spoolman run.
PRINT_BUDDY_IMAGE=
PRINT_BUDDY_DATA=./data
# PRINT_BUDDY_SPOOLMAN_DATA=./data/spoolman
# PRINT_BUDDY_BUNDLED_SPOOLMAN=true
# SPOOLMAN_HOST=127.0.0.1
PRINT_BUDDY__BOT__MODE=standalone
DISCORD_BOT_TOKEN=
# Telegram bot token, used instead when PRINT_BUDDY__BOT__PLATFORM=telegram (#164).
TELEGRAM_BOT_TOKEN=
# Matrix access token, used instead when PRINT_BUDDY__BOT__PLATFORM=matrix (#164).
MATRIX_ACCESS_TOKEN=
PRINT_BUDDY__DISCORD__CHAT_ID=
PRINT_BUDDY__DISCORD__ALLOWED_USER_IDS=
# Runtime environment (docs/SETTINGS.md): bundled OrcaSlicer channel selected at startup.
PRINT_BUDDY_ORCA_CHANNEL=stable
# APP_CHANNEL, WITH_ORCA and WITH_BAMBU are image BUILD arguments, not settings. Select the bundled Orca build at runtime with PRINT_BUDDY_ORCA_CHANNEL=stable (default) or alpha.

# --- Every other scalar setting, commented, with its Docker value (docs/SETTINGS.md) ---
# printer, layout and prime_tower values are the flashforge.ad5x model defaults.
# Lists and tables (orca.command, printer.bed_mm, delivery.methods, material_temps, cold_pull)
# are file-only. Secrets other than the bot token, only when used:
# LLM_API_KEY=
# OCTOPRINT_API_KEY=
# MOONRAKER_API_KEY=
# BAMBU_LAN_PASSWORD=
# CLIPROXY_API_KEY=
# OPENVIKING_API_KEY=
# The MakerWorld account token is a file, not a variable: /data/.config/bambu/token (docs/DOCKER.md).
# Stock Flashforge LAN secrets (with PRINT_BUDDY__FLASHFORGE_STOCK__HOST above):
# AD5X_SERIAL=
# AD5X_CHECK_CODE=
# PRINT_BUDDY__LAYOUT__SINGLE_COPY_EDGE_MM=1.0
# PRINT_BUDDY__LAYOUT__MULTI_COPY_EDGE_MM=3.0
# PRINT_BUDDY__LAYOUT__MERGE_EDGE_MARGIN_MM=8.0
# PRINT_BUDDY__LAYOUT__MERGE_SPACING_MM=10.0
# PRINT_BUDDY__LAYOUT__MAX_MERGED_HOURS=12
# PRINT_BUDDY__PRIME_TOWER__SIZE_MM=45.0
# PRINT_BUDDY__PRIME_TOWER__PART_CLEARANCE_MM=8.0
# PRINT_BUDDY__PRIME_TOWER__EDGE_MM=10.0
# PRINT_BUDDY__PRIME_TOWER__MERGE_SLACK_MM=5.0
# PRINT_BUDDY__PRINTER__FIRMWARE=ZMod Klipper
# PRINT_BUDDY__PRINTER__VENDOR=flashforge
# PRINT_BUDDY__PRINTER__SLICER=orca
# Optional user-installed Flash Studio executable. Empty keeps OrcaSlicer.
# PRINT_BUDDY__SLICER__FLASH_STUDIO_PATH=
# Stock Flashforge LAN. Empty host leaves the printer offline. The serial and
# check code are secrets (AD5X_SERIAL, AD5X_CHECK_CODE), never settings.
# PRINT_BUDDY__FLASHFORGE_STOCK__HOST=
# PRINT_BUDDY__PRINTER__NOZZLE_TYPE=
# PRINT_BUDDY__ORCA__TEMPLATES=
# PRINT_BUDDY__PATHS__HERMES_BIN=/usr/local/bin/hermes
# PRINT_BUDDY__PATHS__HERMES_AGENT=/data/hermes/hermes-agent
# PRINT_BUDDY__PATHS__HERMES_RESTART_HELPER=/data/hermes/restart_hermes.py
# PRINT_BUDDY__SERVICES__OCTOPRINT_URL=
# Bambu Lab read-only LAN status (#187): set host and serial together; the access code
# itself goes in the BAMBU_LAN_PASSWORD secret below, never in a setting.
# PRINT_BUDDY__BAMBU__LAN_HOST=
# PRINT_BUDDY__BAMBU__LAN_SERIAL=
# PRINT_BUDDY__BAMBU__LAN_ACCESS_CODE_ENV=BAMBU_LAN_PASSWORD
# Post-slice delivery methods, comma- or space-separated, from the vendor profile (#270). `printer` is
# the Bambu LAN print opt-in: it adds the Start button and is never a default. A value the vendor does
# not offer stops startup; empty keeps the file value.
# PRINT_BUDDY__DELIVERY__METHODS=discord,bambu_handoff,printer
# PRINT_BUDDY__DISCORD__QUESTION_TIMEOUT_S=1800
# PRINT_BUDDY__DISCORD__SAFETY_CONFIRM_TIMEOUT_S=600
# PRINT_BUDDY__DISCORD__UPLOAD_WAIT_S=3600
# PRINT_BUDDY__DISCORD__COLD_PULL_OUTCOME_S=1800
# PRINT_BUDDY__DISCORD__TOKEN_ENV=DISCORD_BOT_TOKEN
# PRINT_BUDDY__BOT__PLATFORM=discord
# PRINT_BUDDY__BOT__HEALTH_PORT=0
# PRINT_BUDDY__BOT__HEALTH_STALE_S=120
# PRINT_BUDDY__BOT__SYNC_COMMANDS=true
# PRINT_BUDDY__LLM__CHAT_URL=
# PRINT_BUDDY__LLM__MODEL=
# PRINT_BUDDY__LLM__API_KEY_ENV=LLM_API_KEY
# PRINT_BUDDY__LLM__TIMEOUT_S=20
# PRINT_BUDDY__LISTENER__IFS_PRESENCE_POLL_S=15
# PRINT_BUDDY__LISTENER__SPOOL_NAG_S=600
# PRINT_BUDDY__LISTENER__START_CLAIM_TTL_S=1800
# PRINT_BUDDY__VISUAL_WATCH__ENABLED=true
# PRINT_BUDDY__TIMELAPSE__ARCHIVE_DIR=
# PRINT_BUDDY__TIMELAPSE__SSH_KEY=
# PRINT_BUDDY__TIMELAPSE__RENDER_WAIT_S=900
# PRINT_BUDDY__TIMELAPSE__RENDER_POLL_S=10
# PRINT_BUDDY__TIMELAPSE__MAX_BYTES=209715200
# PRINT_BUDDY__TIMELAPSE__LOCAL_RETENTION_DAYS=1
# PRINT_BUDDY__TIMELAPSE__PLAN_CLIP_RETENTION_DAYS=14
# PRINT_BUDDY__LOGGING__LEVEL=INFO
# PRINT_BUDDY__LOGGING__FORMAT=text
# PRINT_BUDDY__LOGGING__FILE=
# PRINT_BUDDY__MAINTENANCE__FULL_HOURS=75
# PRINT_BUDDY__MAINTENANCE__FULL_DAYS=30
